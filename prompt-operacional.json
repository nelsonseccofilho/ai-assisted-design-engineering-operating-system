{
  "meta": {
    "name": "AI-Assisted Design Engineering Operating System",
    "version": "3.4.0",
    "status": "CANONICAL_DERIVATIVE",
    "canonical_source": "PROMPT_OPERACIONAL_MASTER.md",
    "scope": "generic",
    "privacy_rule": "Real project context belongs only in ignored local runtime files."
  },
  "runtime_files": {
    "project_context": "PROJECT_CONTEXT.local.md",
    "current_handoff": "HANDOFF_CURRENT.local.md",
    "local_handoff": "HANDOFF_CURRENT.local.md",
    "workstream_registry_template": "WORKSTREAM_REGISTRY_TEMPLATE.md",
    "workstream_handoff_template": "HANDOFF_TEMPLATE.md",
    "session_record_template": "SESSION_RECORD_TEMPLATE.md",
    "runtime_state_template": "RUNTIME_STATE_TEMPLATE.json",
    "operator_profile_template": "OPERATOR_PROFILE_TEMPLATE.md"
  },
  "first_run": {
    "mode": "generic",
    "required_initial_fields": [
      "product_or_project",
      "primary_stakeholder_or_decision_maker",
      "journey_or_flow"
    ],
    "optional_initial_fields": [
      "organization_or_client",
      "work_package_or_initiative"
    ],
    "conditional_initial_fields": [
      "design_system_name",
      "design_system_url",
      "primary_work_file_name",
      "primary_work_file_url"
    ],
    "principle": "Collect context just in time, not all at once."
  },
  "evidence_priority": [
    "explicit approved project reference or decision",
    "requirements from recordings/transcripts/tickets/specifications",
    "approved existing product behavior",
    "current canonical Design System or UI Kit",
    "local or journey-specific components",
    "external best practices",
    "inference"
  ],
  "reasoning_labels": [
    "FACT",
    "INFERENCE",
    "ASSUMPTION"
  ],
  "source_status": [
    "CANONICAL",
    "HISTORICAL EVIDENCE",
    "SUPERSEDED"
  ],
  "operational_states": [
    "NOT STARTED",
    "IN PROGRESS",
    "READY FOR QA",
    "BLOCKED",
    "READY TO PUBLISH",
    "FINAL",
    "REOPENED",
    "SUPERSEDED"
  ],
  "response_contract": [
    "STATUS",
    "EVIDENCE",
    "ACTION",
    "QA",
    "NEXT"
  ],
  "privacy": {
    "never_hardcode_in_public_framework": [
      "real client or organization names",
      "real stakeholder names",
      "private Figma URLs or file keys",
      "private Design System URLs",
      "proprietary work package or journey names",
      "internal change IDs",
      "credentials or tokens",
      "copied proprietary evidence"
    ]
  },
  "licensing": {
    "copyright_holder": "Nelson Secco Filho",
    "copyright_year": 2026,
    "framework_license": "PolyForm-Noncommercial-1.0.0",
    "documentation_license": "CC-BY-NC-4.0",
    "commercial_use": "Requires a separate written commercial license from the copyright holder",
    "osi_open_source": false
  },
  "decision_governance": {
    "required": true,
    "framework_index": "DECISION_LOG.md",
    "framework_records": "docs/decisions/",
    "template": "docs/decisions/ADR_TEMPLATE.md",
    "statuses": [
      "PROPOSED",
      "ACCEPTED",
      "REJECTED",
      "SUPERSEDED",
      "DEPRECATED"
    ],
    "minimum_fields": [
      "context",
      "evidence",
      "decision",
      "why",
      "impact",
      "status"
    ],
    "rule": "A significant decision is not complete until it is documented."
  },
  "change_history": {
    "principle": "THE FILE / ARTIFACT THAT OWNS THE MUTATION OWNS THE CHANGE RECORD",
    "decision": "ADR-0014",
    "registry": "PROJECT_CONTEXT.local.md",
    "registry_fields": [
      "artifact_identity",
      "governance_location",
      "change_history_location",
      "change_namespace",
      "decision_log_location",
      "evidence_archive"
    ],
    "record_fields": [
      "owner_identity",
      "history_location",
      "qualified_record_id",
      "actual_mutation",
      "evidence_only_dependencies",
      "linked_owner_records",
      "decision_references",
      "when",
      "status",
      "scope",
      "why",
      "evidence",
      "decision",
      "qa",
      "publication_note",
      "consumer_impact",
      "supersession",
      "timestamp_with_offset",
      "timezone",
      "human_operator",
      "operator_alias",
      "chat_label",
      "workstream_id"
    ],
    "rules": {
      "owner_scoped": true,
      "read_only_creates_record": false,
      "multi_owner_linked_records": true,
      "central_fallback_log": false,
      "missing_history_before_final": true,
      "historical_correction": "append-only canonical copy with original archived/pointer evidence",
      "handoff_replaces_history": false
    },
    "framework_history": "CHANGELOG.md"
  },
  "startup_order": [
    "master",
    "project_context_or_onboarding",
    "handoff",
    "owner_registry_and_governance_records",
    "current_state_inspection",
    "reconcile",
    "next_action"
  ],
  "project_runtime": {
    "preferred_for": "long-running multi-chat or multi-operator work",
    "canonical_operational_source": true,
    "canonical_ref_default": "main",
    "workstream_id_pattern": "WS-YYYYMMDD-NNN-<slug>",
    "session_record_pattern": "sessions/<OPERATOR_ALIAS>/<YYYY>/<MM>/<YYYY-MM-DD>_<chat-label>.md",
    "identity_fields": [
      "human_operator",
      "operator_alias",
      "chat_label",
      "workstream_id"
    ],
    "access_modes": [
      "READ_WRITE",
      "READ_ONLY",
      "UNAVAILABLE"
    ],
    "chat_memory_authority": "non-authoritative convenience only",
    "live_artifact_rule": "Current inspected artifact state outranks stale runtime snapshots."
  },
  "continuity": {
    "continuous_handoff": true,
    "context_limit_trigger": "mandatory",
    "next_action_count": 1
  },
  "git_contract": {
    "conventional_commits": "1.0.0",
    "specification": "https://www.conventionalcommits.org/en/v1.0.0/",
    "significant_commit_decision_reference": true
  },
  "operator_daily_reports": {
    "supported": true,
    "required_by_default": false,
    "required_when_project_governance_enables": true,
    "recommended_generate_command": "<operator_alias_lower>_report",
    "recommended_sent_command": "<operator_alias_lower>_report_sent",
    "statuses": [
      "NOT_DUE",
      "DUE",
      "DRAFT",
      "SENT",
      "WAIVED",
      "SUPERSEDED"
    ],
    "cursor_rule": "DRAFT never advances the reporting cursor; SENT advances it.",
    "recommended_first_report_baseline": "start_of_current_reporting_day",
    "source_order": [
      "last_confirmed_report_cursor",
      "session_records",
      "persistent_mutation_records",
      "current_workstream_state",
      "explicit_blockers_dependencies"
    ],
    "report_sections": [
      "worked_since_last_update",
      "planned_today_or_next",
      "blockers_or_help"
    ],
    "blocker_rule": "Do not invent blockers. Distinguish blockers from dependencies."
  }
}
